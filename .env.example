# Online Banking & Fraud Detection System — example configuration
#
# Copy this file to `.env` and adjust the values for your machine.
# `.env` is git-ignored. Never commit real credentials.
# All values below are placeholders for an ACADEMIC prototype.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# Spring profile: `dev` (H2 in-memory, seeded demo data) or `mysql` (MySQL 8).
SPRING_PROFILES_ACTIVE=dev

# Port the Spring Boot backend listens on.
SERVER_PORT=8080

# JWT signing secret. Must be at least 32 characters for HS256.
# Generate your own value before running anything beyond a local demo.
OBFDS_JWT_SECRET=change-me-local-dev-secret-key-min-32-chars
# Token lifetime in minutes.
OBFDS_JWT_EXPIRY_MINUTES=120

# Browser origin allowed to call the API (the Vite dev server).
OBFDS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seed the fictional demo dataset on startup (true for demos, false otherwise).
OBFDS_SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# MySQL (only needed when SPRING_PROFILES_ACTIVE=mysql)
# ---------------------------------------------------------------------------
MYSQL_URL=jdbc:mysql://localhost:3306/obfds?createDatabaseIfNotExist=true&serverTimezone=UTC
MYSQL_USERNAME=obfds_user
MYSQL_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Fraud rule thresholds (FR-11, FR-12) — deterministic and configurable
# ---------------------------------------------------------------------------
OBFDS_FRAUD_HIGH_AMOUNT=50000
OBFDS_FRAUD_VERY_HIGH_AMOUNT=100000
OBFDS_FRAUD_NEW_BENEFICIARY_HOURS=24
OBFDS_FRAUD_VELOCITY_COUNT=3
OBFDS_FRAUD_VELOCITY_MINUTES=10

# ---------------------------------------------------------------------------
# Frontend (Vite) — put these in frontend/.env
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
