<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.11</version>
        <relativePath/>
    </parent>

    <groupId>com.sepro</groupId>
    <artifactId>obfds-backend</artifactId>
    <version>1.0.0</version>
    <name>Online Banking and Fraud Detection System - Backend</name>
    <description>Backend API for the Online Banking and Fraud Detection System</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Exposes /actuator/health so the deployment can be monitored (NFR-03). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            Versioned schema migrations. Flyway is NOT run by the application at start-up (see
            spring.flyway.enabled=false in application.yml): the schema is changed only by the
            separate migrator (com.sepro.obfds.migrate.Migrator) with DDL credentials, so the
            running service can use a database account that cannot alter tables.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!--
                    Two executions, both bound to `mvn test`, each in its own forked JVM:

                    1. default-test          every test EXCEPT those tagged `concurrency`
                    2. committed-data-tests  ONLY the tests tagged `concurrency`

                    The tagged tests commit real rows and run genuinely overlapping transactions
                    (a race only exists if two requests reach the database before either commits),
                    so they create their own throw-away customers and must not share a JVM with
                    tests that assume the seeded balances are untouched. Splitting them keeps one
                    `mvn test` honest: both executions run and each reports its own test count,
                    and CI asserts that both counts are non-zero (an excluded test is not
                    "skipped", so a green exit code alone proves nothing).

                    To run one class on its own add -Dsurefire.failIfNoSpecifiedTests=false, e.g.
                    mvn test -Dtest=MoneyPathIntegrityTest -Dsurefire.failIfNoSpecifiedTests=false
                -->
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludedGroups>concurrency</excludedGroups>
                        </configuration>
                    </execution>
                    <execution>
                        <id>committed-data-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <groups>concurrency</groups>
                            <excludedGroups></excludedGroups>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
